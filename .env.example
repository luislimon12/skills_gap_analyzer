# Copy to .env and fill in. .env is in .gitignore - never commit real values.
# On the VM keep it readable only by the app user:  chmod 600 .env

# Adzuna API keys (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Database. Leave empty for the local SQLite file (data/skills_gap.db).
# Production: postgresql+psycopg://skills_app:<password>@127.0.0.1:5432/skills_gap
DATABASE_URL=

# Random secret for signing anonymous sessions:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Fernet key for encrypting stored resume files (only used if resumes.store_file is true):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional: LoopCV (leave empty until the API details are confirmed)
LOOPCV_API_KEY=

# Optional: worker failure / low-disk alert email
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Backups (deploy/backup/backup.sh). The matching age PRIVATE key must NOT be on the server.
BACKUP_AGE_RECIPIENT=
BACKUP_BUCKET=
