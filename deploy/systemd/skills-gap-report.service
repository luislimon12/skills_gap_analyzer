# Daily failure check of fetch_runs (emails only when there were failed/partial runs).
[Unit]
Description=Skills Gap Analyzer daily fetch_runs failure report

[Service]
Type=oneshot
User=skillsgap
Group=skillsgap
WorkingDirectory=/opt/skills_gap_analyzer
EnvironmentFile=/opt/skills_gap_analyzer/.env
Environment=HOME=/opt/skills_gap_analyzer/data/home
ExecStart=/opt/skills_gap_analyzer/.venv/bin/python -m src.worker report --days 1 --email
SuccessExitStatus=1
